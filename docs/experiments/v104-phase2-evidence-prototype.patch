+def adherence_normalized_distance(
+    actual_miles: float,
+    prescribed_range_miles: tuple[float, float] | None,
+) -> float:
+    """Return prescribed midpoint plus only out-of-range execution deviation.
+
+    Actual distance remains available to observed easy-run baselines. This
+    normalized value is only for the conditional mileage/capacity ledger,
+    where every value inside a prescribed range is equally compliant.
+    """
+
+    actual = max(0.0, actual_miles)
+    if prescribed_range_miles is None:
+        return actual
+    low, high = prescribed_range_miles
+    low = max(0.0, low)
+    high = max(low, high)
+    midpoint = (low + high) / 2.0
+    if actual < low:
+        return max(0.0, midpoint - (low - actual))
+    if actual > high:
+        return midpoint + (actual - high)
+    return midpoint
+
+
